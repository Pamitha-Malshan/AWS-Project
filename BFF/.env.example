PORT=3000

# Comma-separated list of allowed SPA origins
CORS_ORIGINS=http://localhost:5173

# AWS credentials (for local dev only — use IAM Role in production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# The S3 bucket where product JSON files will be stored
S3_BUCKET_NAME=your-bucket-name-here

DB_HOST=my-app-db.xxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=myappdb        # or whatever DB name you set
DB_USER=admin          # your master username
DB_PASSWORD=yourpassword
